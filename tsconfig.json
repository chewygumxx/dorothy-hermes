{
    "$schema": "https://json.schemastore.org/tsconfig.json",
    "compilerOptions": {
        "target": "esnext",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "strict": true,
        "noEmit": true,
        "allowJs": true,
        "checkJs": true,
        "types": ["bun"],
        "skipLibCheck": true
    },
    "include": [".commitlintrc.mts"]
}
