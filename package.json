{
    "name": "dorothy-hermes",
    "description": "Container for deployment of personal Hermes Agent",
    "private": true,
    "keywords": [
        "dorothy"
    ],
    "license": "GPL-3.0-only",
    "homepage": "https://github.com/chewygumxx/dorothy-hermes",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/chewygumxx/dorothy-hermes.git"
    },
    "engines": {
        "bun": ">=1.4"
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.14",
        "@chewygumxx/biome-config": "^1.0.0",
        "@chewygumxx/commitlint-config": "^1.1.0",
        "@chewygumxx/cz-commitlint": "^1.0.2",
        "@chewygumxx/remark-preset": "^1.0.3",
        "@chewygumxx/yamllint-config": "^1.0.0",
        "@commitlint/cli": "^21.2.2",
        "@types/bun": "^1.4.2",
        "@types/node": "26.6.4",
        "commitizen": "^4.3.2",
        "husky": "^9.1.7",
        "prettier": "^3.9.9",
        "remark-cli": "^12.0.1",
        "typescript": "^7.0.2"
    },
    "scripts": {
        "check": "bun run typecheck && bun run lint:biome && bun run lint:md && bun run lint:yaml && bun run lint:toml && bun run lint:sh && bun run lint:emdash",
        "commit": "cz",
        "format": "biome format --write . && bun run format:yaml && bun run format:toml",
        "format:check": "biome format .",
        "format:toml": "git ls-files -z '*.toml' | xargs -0 -r tombi format",
        "format:yaml": "git ls-files -z '*.yaml' '*.yml' | xargs -0 -r prettier --write --log-level warn",
        "lint": "biome lint .",
        "lint:biome": "biome ci .",
        "lint:emdash": "git grep -nIP --untracked '\\x{2014}'; test $? -eq 1",
        "lint:md": "git ls-files -z '*.md' | xargs -0 remark --frail --quiet --no-stdout",
        "lint:sh": "sh scripts/lint-sh.sh",
        "lint:toml": "git ls-files -z '*.toml' | xargs -0 -r tombi format --check && git ls-files -z '*.toml' | xargs -0 -r tombi lint --error-on-warnings",
        "lint:yaml": "git ls-files -z '*.yaml' '*.yml' | xargs -0 -r prettier --check && git ls-files -z '*.yaml' '*.yml' | xargs -0 -r yamllint --strict",
        "prepare": "test -d node_modules/husky && husky || true",
        "typecheck": "tsc && tsc -p hermes/src && tsc -p scripts"
    },
    "config": {
        "commitizen": {
            "path": "@chewygumxx/cz-commitlint"
        }
    },
    "remarkConfig": {
        "plugins": [
            "@chewygumxx/remark-preset"
        ]
    }
}
